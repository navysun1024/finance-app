    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "echarts": "^5.5.0",
    "express": "^5.2.1",
    "lucide-vue-next": "^0.31.0",
    "puppeteer": "^25.1.0",
    "sql.js": "^1.14.1",
    "sqlite3": "^6.0.1",
    "tailwindcss": "^3.4.14",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "xlsx": "^0.18.5"
  },
